<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>True</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>preview</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- The TextMate grammar of the language, one file for VS Code (editors/vscode) and for Hex, read through HIDLGrammar -->
    <EmbeddedResource Include="editors\vscode\syntaxes\hidl.tmLanguage.json" LogicalName="hidl.tmLanguage.json" />
  </ItemGroup>

</Project>
